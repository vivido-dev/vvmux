{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "chart"],
  "properties": {
    "summary": { "type": "string", "maxLength": 512 },
    "chart": {
      "type": "object",
      "required": ["count", "minimum", "maximum"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
